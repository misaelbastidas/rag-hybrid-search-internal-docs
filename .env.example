OPENAI_API_KEY=

# Optional: set these to use Azure OpenAI instead of standard OpenAI.
# If AZURE_OPENAI_ENDPOINT is set, Azure is used and OPENAI_API_KEY above is ignored.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Used for answer generation (Phase 3)
ANTHROPIC_API_KEY=

# Required to call POST /v1/ingest (re-embedding). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this unset disables the endpoint entirely (fails closed).
ADMIN_API_KEY=
